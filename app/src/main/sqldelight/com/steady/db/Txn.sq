CREATE TABLE Txn (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    amount INTEGER NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE TABLE Tag(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL
);

CREATE TABLE TxnTag (
    txn_id INTEGER NOT NULL,
    tag_id INTEGER NOT NULL,
    PRIMARY KEY (txn_id, tag_id),
    FOREIGN KEY (txn_id) REFERENCES Txn(id) ON DELETE CASCADE,
    FOREIGN KEY (tag_id) REFERENCES Tag(id) ON DELETE CASCADE
);

insert:
INSERT INTO Txn(
    title,
    amount,
    createdAt
)
VALUES (
?,
?,
?
);

getAll:
SELECT * FROM Txn;

createNewTag:
INSERT INTO Tag(name) VALUES (?);

addTag:
INSERT INTO TxnTag(txn_id, tag_id) VALUES (?,?);

getAllTags:
SELECT * FROM Tag;

getLastRowInsertId:
SELECT last_insert_rowid();

getTagListByTxnId:
SELECT Tag.* FROM Tag
JOIN TxnTag ON Tag.id = TxnTag.tag_id
WHERE TxnTag.txn_id = ?;

getTxnListByTagId:
SELECT Txn.* FROM Txn
JOIN TxnTag ON Txn.id = TxnTag.txn_id
WHERE TxnTag.tag_id = ?;