 CREATE TABLE Txn (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    amount INTEGER NOT NULL,
    suspendedStatus INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE TABLE Tag(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL
);

CREATE TABLE TxnTag (
    txn_id INTEGER NOT NULL,
    tag_id INTEGER NOT NULL,
    PRIMARY KEY (txn_id, tag_id),
    FOREIGN KEY (txn_id) REFERENCES Txn(id) ON DELETE CASCADE,
    FOREIGN KEY (tag_id) REFERENCES Tag(id) ON DELETE CASCADE
);

insertTxn:
INSERT INTO Txn(
    title,
    amount,
    suspendedStatus,
    createdAt
)
VALUES (
?,
?,
?,
?
);
insertTxnWithId:
INSERT INTO Txn(
    id,
    title,
    amount,
    suspendedStatus,
    createdAt
)
VALUES (
?,
?,
?,
?,
?
);

updateTxn:
UPDATE Txn SET
    title = ?,
    amount = ?,
    suspendedStatus = ?
WHERE id = ?;

getAllTxn:
SELECT * FROM Txn;

getAllTxnTag:
SELECT * FROM TxnTag;

insertTag:
INSERT INTO Tag(name) VALUES (?);

insertTagWithId:
INSERT INTO Tag(
    id,
    name
) VALUES (
    ?,
    ?
);

addTag:
INSERT INTO TxnTag(txn_id, tag_id) VALUES (?,?);

getAllTags:
SELECT * FROM Tag;

getLastRowInsertId:
SELECT last_insert_rowid();

getTagListByTxnId:
SELECT Tag.* FROM Tag
JOIN TxnTag ON Tag.id = TxnTag.tag_id
WHERE TxnTag.txn_id = ?;

getTxnListByTagId:
SELECT Txn.* FROM Txn
JOIN TxnTag ON Txn.id = TxnTag.txn_id
WHERE TxnTag.tag_id = ?;

getTxnById:
SELECT * FROM Txn
WHERE id = ?;

removeAllTagFromTxn:
DELETE FROM TxnTag
WHERE txn_id = ?;

delteTxn:
DELETE FROM Txn
WHERE id = ?;

deleteAllTxn:
DELETE FROM Txn;

deleteAllTag:
DELETE FROM Tag;

deleteAllTxnTag:
DELETE FROM TxnTag;
